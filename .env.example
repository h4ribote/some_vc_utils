# Copy this file to .env and fill in the secrets; .env holds credentials and must never be committed.
# Compose passes it to every application container and also reads SVU_DB_NAME, SVU_DB_USER, SVU_DB_PASSWORD and POSTGRES_HOST_PORT from it for the postgres service.
# The application rejects unknown SVU_ names at startup and exits with code 78 when a value its role needs is missing or invalid.

# Database host name inside the compose network (default postgres).
SVU_DB_HOST=postgres
# Database port inside the compose network, 1-65535 (default 5432).
SVU_DB_PORT=5432
# Database name, also created by the postgres service on first start (default svu).
SVU_DB_NAME=svu
# Database user, also created by the postgres service on first start (default svu).
SVU_DB_USER=svu
# Database password, at least 8 characters; it takes effect in postgres only when the pgdata volume is first initialized (required).
SVU_DB_PASSWORD=change-me-db-password

# Discord bot token (required by bot and worker).
SVU_DISCORD_TOKEN=
# Discord application (client) id, used for the dashboard login (required by api).
SVU_DISCORD_CLIENT_ID=
# Discord application client secret, used for the dashboard login (required by api).
SVU_DISCORD_CLIENT_SECRET=

# VirtualCrypto API origin (default https://vcrypto.sumidora.com).
SVU_VC_BASE_URL=https://vcrypto.sumidora.com
# VirtualCrypto application client id (required by bot, api, worker and vc-sync).
SVU_VC_CLIENT_ID=
# VirtualCrypto application client secret (required by bot, api, worker and vc-sync).
SVU_VC_CLIENT_SECRET=

# The public https origin of the Cloudflare Tunnel hostname, without a path, such as https://svu.example.com (required by api and vc-sync; without it the worker leaves the VirtualCrypto webhook URL unchanged).
SVU_PUBLIC_BASE_URL=
# At least 32 random characters; encrypts stored tokens and must stay the same across restarts (required by bot, api and worker). Generate with: openssl rand -base64 48
SVU_SECRET_KEY=

# Comma-separated Discord user ids allowed to open the dashboard's administration page (default empty).
SVU_ADMIN_IDS=

# Seconds a claim waits for approval before it is canceled, 60-86400 (default 600).
SVU_CLAIM_TIMEOUT_SECONDS=600

# Absolute directory inside the container where backups are written; compose mounts the backups volume there (default /var/lib/svu/backups).
SVU_BACKUP_DIR=/var/lib/svu/backups
# Number of backups kept; older ones are deleted (default 14).
SVU_BACKUP_RETENTION=14
# Seconds from the newest backup to the next one, at least 3600 (default 86400).
SVU_BACKUP_INTERVAL_SECONDS=86400

# Address and port the API listens on inside its container; cloudflared reaches it at http://api:8000 (defaults 0.0.0.0 and 8000).
SVU_API_HOST=0.0.0.0
SVU_API_PORT=8000

# DEBUG, INFO, WARNING, ERROR or CRITICAL (default INFO).
SVU_LOG_LEVEL=INFO

# Compose interpolation only, not read by the application: host port on 127.0.0.1 where PostgreSQL is published for SSH port forwarding (default 5432).
POSTGRES_HOST_PORT=5432
