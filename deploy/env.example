# Copy to <repo>/.env and fill in; real environment variables override values in .env.

# Required: Discord bot token.
SVU_DISCORD_TOKEN=your-discord-bot-token
# Required: comma separated Discord user ids allowed to use admin commands (mention kill, /refresh).
SVU_ADMIN_IDS=123456789012345678,234567890123456789
# Required: VirtualCrypto OAuth client id.
SVU_VC_CLIENT_ID=your-virtualcrypto-client-id
# Required: VirtualCrypto OAuth client secret.
SVU_VC_CLIENT_SECRET=your-virtualcrypto-client-secret

# Optional: hours between automatic database backups (default 6).
SVU_BACKUP_INTERVAL_HOURS=6
# Optional: number of backups kept in backups/; older ones are deleted (default 28).
SVU_BACKUP_RETENTION=28
# Optional: log level, one of DEBUG, INFO, WARNING, ERROR (default INFO).
SVU_LOG_LEVEL=INFO
# Optional: size in bytes at which logs/bot.log is rotated (default 10485760).
SVU_LOG_MAX_BYTES=10485760
# Optional: number of rotated log files kept (default 5).
SVU_LOG_BACKUP_COUNT=5
